(ns tod
  "Themes and wallpapers that follow the sun and the seasons.

tod works out where the sun stands for your location: night, the three
twilights, golden hour or day, whether it is rising or setting, the
astronomical season (flipped south of the equator), the month and the
calendar periods in effect.  Ordered rules in `tod-looks' turn that into
a look: an Emacs theme, a desktop wallpaper, and optionally a palette
that pywal derives from the wallpaper and tod repairs to readable
contrast.  `tod-mode' keeps the look current, waking at each twilight
boundary rather than polling.

Set `tod-latitude' and `tod-longitude' (or `calendar-latitude' and
`calendar-longitude'), then enable `tod-mode'.  M-x tod-describe shows the
sun, the season, today's boundaries and the look tod picked.  Put
%%(tod-diary-sun) in a diary or Org file to see the day's twilight
times in the agenda.

Wallpapers come from `tod-wallpaper-directory', organised as
SEASON/PHASE/, with any for either part and _period/NAME/ or _month/MM/
for calendar overrides.  Setters for GNOME, Cinnamon, MATE, KDE Plasma,
Xfce, Hyprland, sway, swww, swaybg, feh, xwallpaper and nitrogen are
built in, and lazywal plays video wallpapers; register more with
`tod-wallpaper-register-setter'."
  {:elisp/package {:author "Pedro G. Branquinho <pedrogbranquinho@gmail.com>"
                   :url "https://github.com/BuddhiLW/tod"
                   :version "0.1.0"
                   :package-requires [[emacs "29.1"]]
                   :keywords ["faces" "calendar" "convenience"]
                   :license "GPL-3.0-or-later"
                   :copyright "2026 Pedro G. Branquinho"}}
  (:require [tod.moment :as moment]
            [tod.look :as look]
            [tod.sun :as sun]
            [tod.theme :as theme]
            [tod.wallpaper :as wallpaper]
            [tod.palette :as palette]
            [xdg]))

(defgroup tod nil
  "Themes and wallpapers that follow the sun and the seasons."
  :group 'faces
  :prefix "tod-")

(defcustom tod-latitude nil
  "Latitude in degrees, north positive, or nil to use `calendar-latitude'."
  :type '(choice (const :tag "Use calendar-latitude" nil) number)
  :group 'tod)

(defcustom tod-longitude nil
  "Longitude in degrees, east positive, or nil to use `calendar-longitude'."
  :type '(choice (const :tag "Use calendar-longitude" nil) number)
  :group 'tod)

(defcustom tod-phases tod-moment-default-ladder
  "Phases of the day by the sun's minimum altitude in degrees.
Each entry is (PHASE MIN-ALTITUDE), highest first; the last entry
catches everything below the one before it."
  :type '(repeat (list symbol number))
  :group 'tod)

(defcustom tod-looks
  '((:phase night :season winter :theme (ef-winter ef-night modus-vivendi-tinted modus-vivendi))
    (:phase night :season autumn :theme (ef-autumn ef-night modus-vivendi))
    (:phase night :theme (ef-night ef-dark modus-vivendi))
    (:phase (astronomical-twilight nautical-twilight)
     :theme (ef-dream ef-maris-dark modus-vivendi-tinted modus-vivendi))
    (:phase civil-twilight :rising t :theme (ef-elea-dark modus-vivendi-tinted modus-vivendi))
    (:phase civil-twilight :theme (ef-melissa-dark ef-autumn modus-vivendi-tinted modus-vivendi))
    (:phase golden-hour :theme (ef-melissa-light modus-operandi-tinted modus-operandi))
    (:season spring :theme (ef-spring modus-operandi-tinted modus-operandi))
    (:season summer :theme (ef-summer ef-day modus-operandi))
    (:season autumn :theme (ef-cyprus ef-day modus-operandi-tinted modus-operandi))
    (:season winter :theme (ef-frost modus-operandi))
    (:theme modus-operandi :wallpaper t))
  "Rules that turn the sun and the calendar into a look.
Each rule is a plist of criteria and attributes.  Criteria are the keys
of `tod-look-criteria': :phase, :season, :month, :rising, :period,
:hour, :altitude and :when.  Attributes are:

  :theme      a theme, or a list of alternatives tried in order
  :wallpaper  a file, a directory to pick from, or t for the layout
              under `tod-wallpaper-directory'
  :palette    wal to build the theme from the wallpaper with pywal

Each attribute comes from the first matching rule that sets it."
  :type '(repeat (plist :key-type symbol :value-type sexp))
  :group 'tod)

(defcustom tod-holidays nil
  "Holidays that count as periods, in the format of `calendar-holidays'.
Nil means use `calendar-holidays' itself."
  :type '(choice (const :tag "Use calendar-holidays" nil) (repeat sexp))
  :group 'tod)

(defcustom tod-periods nil
  "Named date spans that count as periods.
Each entry is (NAME (MONTH DAY) (MONTH DAY)), inclusive; a span whose
end comes before its start wraps over the new year."
  :type '(repeat (list string (list integer integer) (list integer integer)))
  :group 'tod)

(defcustom tod-wallpaper-directory nil
  "Root of the wallpaper layout, or nil for tod/ in the Pictures folder."
  :type '(choice (const :tag "Pictures/tod" nil) directory)
  :group 'tod)

(defcustom tod-palette-scope 'isolated
  "How far a pywal palette reaches.
isolated keeps pywal's output in tod's cache and leaves terminals and
other programs alone; system lets pywal recolour the desktop as it does
when run by hand or by lazywal."
  :type '(choice (const isolated) (const system))
  :group 'tod)

(defcustom tod-minimum-contrast 4.5
  "WCAG contrast every colour of a generated palette must reach."
  :type 'number
  :group 'tod)

(defcustom tod-warmth 0.06
  "How much warm light tints generated backgrounds while the sun is low."
  :type 'number
  :group 'tod)

(defcustom tod-refresh-interval 1800
  "Longest time in seconds between two checks of the look."
  :type 'integer
  :group 'tod)

(defcustom tod-apply-functions nil
  "Functions called after tod applies a look, with the look and moment."
  :type 'hook
  :group 'tod)

(defcustom tod-phase-change-functions nil
  "Functions called when the phase changes, with new phase, old phase and moment."
  :type 'hook
  :group 'tod)

(defvar tod-mode)

(declare-function dbus-register-signal "dbus")
(declare-function dbus-unregister-object "dbus")
(declare-function package-install "package")

(defvar tod--timer nil
  "Timer that wakes tod at the next boundary.")

(defvar tod--moment nil
  "The moment tod last resolved.")

(defvar tod--look nil
  "The look tod last applied.")

(defvar tod--wallpaper nil
  "The wallpaper file tod last applied.")

(defvar tod--palette-image nil
  "The image the current generated palette was derived from.")

(defvar tod--override-until nil
  "Time until which a theme the user enabled by hand is respected.")

(defvar tod--resume-signal nil
  "D-Bus registration for resume from suspend, when there is one.")

(defvar tod--last-error nil
  "The last error tod met while applying a look, or nil.")

;;; Configuration

(defn location
  "Return (LATITUDE LONGITUDE) from tod's or the calendar's settings, or nil."
  []
  (let [lat (or tod-latitude (and (boundp 'calendar-latitude) calendar-latitude
                                  (calendar-latitude)))
        lon (or tod-longitude (and (boundp 'calendar-longitude) calendar-longitude
                                   (calendar-longitude)))]
    (when (and (numberp lat) (numberp lon))
      (list (float lat) (float lon)))))

(defn layout-root
  "Return the wallpaper layout root directory."
  []
  (or tod-wallpaper-directory
      (expand-file-name "tod" (or (xdg-user-dir "PICTURES") (expand-file-name "~/Pictures")))))

(defn cache-directory
  "Return the directory tod keeps extracted frames and palettes in."
  []
  (expand-file-name "tod" (or (getenv "XDG_CACHE_HOME") (expand-file-name "~/.cache"))))

(defn holiday-list
  "Return the holiday list periods are drawn from."
  []
  (or tod-holidays (and (boundp 'calendar-holidays) calendar-holidays)))

(defn current-moment
  "Return the moment at TIME for the configured location, or nil."
  [time]
  (let [loc (location)]
    (when loc
      (moment/at (or time (current-time)) (nth loc 0) (nth loc 1) tod-phases (holiday-list) tod-periods))))

(defn pick-look
  "Return the look `tod-looks' gives the moment M."
  [m]
  (look/resolve tod-looks m tod-look-criteria #'tod-theme-available-p))

;;; Applying a look

(defn- note-error
  "Remember MSG as tod's last error and show it."
  [msg]
  (setq tod--last-error msg)
  (message "Tod: %s" msg))

(defn- light-phase-p
  "Return non-nil when PHASE is bright enough for a light palette."
  [phase]
  (memq phase (list 'day 'golden-hour)))

(defn- apply-palette
  "Build and enable a theme from the palette pywal derives from IMAGE.
M is the moment, whose phase decides light or dark and warmth."
  [image m]
  (setq tod--palette-image image)
  (palette/generate image (cache-directory) (light-phase-p (get m :phase))
                    (eq tod-palette-scope 'system)
                    (fn [wal err]
                      (if wal
                        (let [p (palette/semantic (palette/tint wal (get m :phase) tod-warmth)
                                                  tod-minimum-contrast)]
                          (theme/define-palette-theme 'tod-wal p)
                          (theme/switch 'tod-wal))
                        (note-error err)))))

(defn- theme-overridden-p
  "Return non-nil while a theme the user chose by hand is respected."
  []
  (and tod--override-until (time-less-p nil tod--override-until)))

(defn apply-look
  "Apply LOOK for the moment M: theme, wallpaper and palette.
Parts that did not change are left alone, so applying the same look
twice does nothing."
  [look m]
  (let [wants-palette (eq (get look :palette) 'wal)
        theme-name (get look :theme)
        file (when (get look :wallpaper)
               (wallpaper/choose-file (get look :wallpaper) m (layout-root)))]
    (when (and theme-name (not wants-palette) (not (theme-overridden-p)))
      (theme/switch theme-name))
    (cond
      (and file (not (equal file tod--wallpaper)))
      (let [p (wallpaper/apply-file file tod-wallpaper-setters (cache-directory)
                                    (fn [ok message]
                                      (when-not ok (note-error message))))]
        (setq tod--wallpaper file)
        (when (and wants-palette (get p :image) (not (theme-overridden-p)))
          (run-at-time 2.0 nil (fn [] (apply-palette (get p :image) m)))))

      (and wants-palette (not (theme-overridden-p))
           (or (not (eq (get tod--moment :phase) (get m :phase)))
               (null tod--palette-image)))
      (let [image (or (and tod--wallpaper
                           (get (wallpaper/plan tod--wallpaper tod-wallpaper-setters (cache-directory)) :image))
                      (get (palette/read-wal (palette/wal-colors-file (cache-directory) true)) :wallpaper))]
        (if (and image (file-readable-p image))
          (apply-palette image m)
          (note-error "No wallpaper image to derive a palette from")))
      :else nil)
    (run-hook-with-args 'tod-apply-functions look m)
    look))

;;; Scheduling

(defn next-wakeup
  "Return the Lisp time tod should look again after TIME.
It is the next phase boundary, the next local midnight or
`tod-refresh-interval' from now, whichever comes first."
  [time]
  (let [loc (location)
        boundary (when loc (moment/next-change time (nth loc 0) (nth loc 1) tod-phases))
        candidates (delq nil (list boundary
                                   (moment/next-midnight time)
                                   (time-add time tod-refresh-interval)))]
    (car (sort (fn [a b] (time-less-p a b)) candidates))))

(defn- arm-timer
  "Arrange for `tod-refresh' to run just after the next boundary."
  []
  (when (timerp tod--timer) (cancel-timer tod--timer))
  (let [delay (max 1.0 (+ 1.0 (float-time (time-subtract (next-wakeup nil) nil))))]
    (setq tod--timer (run-at-time delay nil #'refresh))))

(defn refresh
  "Resolve the look for now, apply what changed and schedule the next check."
  []
  (interactive)
  (let [m (current-moment nil)]
    (if (null m)
      (note-error "Set `tod-latitude' and `tod-longitude' first")
      (let [look (pick-look m)
            old-phase (get tod--moment :phase)]
        (setq tod--last-error nil)
        (condition-case err
            (apply-look look m)
          (error (note-error (error-message-string err))))
        (when (and tod--override-until (not (theme-overridden-p)))
          (setq tod--override-until nil))
        (unless (eq old-phase (get m :phase))
          (run-hook-with-args 'tod-phase-change-functions (get m :phase) old-phase m))
        (setq tod--moment m)
        (setq tod--look look))))
  (when tod-mode (arm-timer)))

(defn- on-enable-theme
  "Respect THEME until the next boundary when the user enabled it by hand."
  [theme]
  (when (and (not tod-theme--applying)
             (not (eq theme 'user))
             (theme/color-scheme-p theme)
             (not (eq theme (get tod--look :theme))))
    (setq tod--override-until (next-wakeup nil))))

(defn- on-resume
  "Refresh after the machine wakes up; SLEEPING is non-nil on the way down."
  [sleeping]
  (unless sleeping
    (run-at-time 3.0 nil #'refresh)))

(defn- watch-resume
  "Register for logind's resume signal when D-Bus is available."
  []
  (when (and (featurep 'dbusbind) (require 'dbus nil true))
    (setq tod--resume-signal
          (condition-case nil
              (dbus-register-signal :system "org.freedesktop.login1" "/org/freedesktop/login1"
                                    "org.freedesktop.login1.Manager" "PrepareForSleep"
                                    #'on-resume)
            (error nil)))))

(defn- start
  "Start following the sun."
  []
  (when (null (location))
    (setq tod-mode nil)
    (user-error "Set `tod-latitude' and `tod-longitude' before enabling tod-mode"))
  (add-hook 'enable-theme-functions #'on-enable-theme)
  (watch-resume)
  (refresh))

(defn- stop
  "Stop following the sun, leaving the current look in place."
  []
  (when (timerp tod--timer) (cancel-timer tod--timer))
  (setq tod--timer nil)
  (remove-hook 'enable-theme-functions #'on-enable-theme)
  (when tod--resume-signal
    (condition-case nil (dbus-unregister-object tod--resume-signal) (error nil))
    (setq tod--resume-signal nil)))

(define-minor-mode ^:autoload tod-mode
  "Keep themes and wallpaper in step with the sun and the seasons.
When enabled, tod applies the look `tod-looks' gives the current moment
and wakes at every twilight boundary, local midnight and at most every
`tod-refresh-interval' seconds to apply the next one."
  :global true
  :lighter " tod"
  :group 'tod
  (if tod-mode (start) (stop)))

;;; Commands

(defn- phase-label
  "Return a readable name for the symbol PHASE."
  [phase]
  (let [words (string-replace "-" " " (symbol-name phase))]
    (str (upcase (substring words 0 1)) (substring words 1))))

(defn- phase-entered
  "Return the phase the sun enters when crossing HEIGHT, RISING or not."
  [height rising]
  (let [steps tod-phases
        above (seq-find (fn [s] (= (second s) height)) steps)
        below (second (seq-drop-while (fn [s] (not (= (second s) height))) steps))]
    (first (if rising above below))))

(defn event-label
  "Return the diary label of the crossing of HEIGHT, RISING or not."
  [height rising]
  (cond
    (and (= height -0.833) rising) "Sunrise"
    (= height -0.833) "Sunset"
    :else (str (phase-label (or (phase-entered height rising) 'night)) " begins")))

(defn- format-events
  "Return the crossings of DAY as \"HH:MM Label\" strings.
LAT and LON give the place."
  [day lat lon]
  (let [start (encode-time (list 0 0 0 (nth day 1) (nth day 0) (nth day 2) nil -1 nil))
        end (time-add start 86400)
        events (seq-filter (fn [e] (and (not (time-less-p (get e :time) start))
                                        (time-less-p (get e :time) end)))
                           (sun/events-around (time-add start 43200) lat lon
                                              (moment/ladder-heights tod-phases)))]
    (mapcar (fn [e] (str (format-time-string "%H:%M" (get e :time)) " "
                         (event-label (get e :height) (get e :rising))))
            events)))

(defn ^:autoload diary-sun
  "Return the day's twilight and sun events for diary and Org agenda.
Use it as %%(tod-diary-sun) in a diary or Org file: each event becomes
its own timed agenda line."
  []
  (let [diary-var (intern-soft "date")
        day (when (and diary-var (boundp diary-var)) (symbol-value diary-var))
        loc (location)]
    (when (and day loc)
      (string-join (format-events day (nth loc 0) (nth loc 1)) "; "))))

(defn ^:autoload describe
  "Show the sun, the season, today's boundaries and the chosen look."
  []
  (interactive)
  (let [m (current-moment nil)]
    (when (null m)
      (user-error "Set `tod-latitude' and `tod-longitude' first"))
    (let [look (pick-look m)
          loc (location)
          wake (next-wakeup nil)]
      (with-help-window "*tod*"
        (princ (format "Location   %.4f, %.4f\n" (nth loc 0) (nth loc 1)))
        (princ (format "Sun        %.1f° altitude, %.0f° bearing, %s\n"
                       (get m :altitude) (get m :azimuth) (if (get m :rising) "rising" "setting")))
        (princ (format "Phase      %s\n" (phase-label (get m :phase))))
        (princ (format "Season     %s (%d%% through)\n" (phase-label (get m :season))
                       (round (* 100 (get m :season-progress)))))
        (princ (format "Periods    %s\n" (or (string-join (get m :periods) ", ") "")))
        (princ (format "Next check %s\n\n" (format-time-string "%F %H:%M" wake)))
        (princ "Today\n")
        (doseq [line (format-events (moment/local-date nil) (nth loc 0) (nth loc 1))]
          (princ (str "  " line "\n")))
        (princ "\nLook\n")
        (princ (format "  theme      %s\n" (or (get look :theme) "unchanged")))
        (princ (format "  wallpaper  %s\n"
                       (or (when (get look :wallpaper)
                             (wallpaper/choose-file (get look :wallpaper) m (layout-root)))
                           "none")))
        (princ (format "  palette    %s\n" (or (get look :palette) "theme's own")))
        (princ (format "\nWallpaper setters (%s session, %s)\n"
                       (or (wallpaper/session-type) "unknown")
                       (string-join (wallpaper/desktop-names) ":")))
        (doseq [s (wallpaper/candidates tod-wallpaper-setters 'image (wallpaper/session-type)
                                        (wallpaper/desktop-names))]
          (let [why (wallpaper/missing s)]
            (princ (format "  %-12s %s\n" (get s :id) (if why (string-join why ", ") "ready")))))
        (when tod--last-error
          (princ (format "\nLast error: %s\n" tod--last-error)))))))

(defn ^:autoload preview
  "Apply the look for PHASE and SEASON now, without touching the wallpaper.
The next boundary restores the real look."
  [phase season]
  (interactive (list (intern (completing-read "Phase: " (mapcar (fn [s] (symbol-name (first s))) tod-phases) nil true))
                     (intern (completing-read "Season: " (list "spring" "summer" "autumn" "winter") nil true))))
  (let [m (or (current-moment nil) {:periods nil})
        fake (cons (cons :phase phase) (cons (cons :season season) m))
        look (pick-look fake)]
    (when (get look :theme)
      (theme/switch (get look :theme)))
    (message "Previewing %s in %s: %s" phase season (or (get look :theme) "no theme"))))

(defn ^:autoload install-themes
  "Install the ef-themes collection, which the default looks prefer."
  []
  (interactive)
  (when (y-or-n-p "Install ef-themes from GNU ELPA? ")
    (package-install 'ef-themes)))
