(ns tod.moment
  "Where the sun and the calendar stand at a given time.

A moment is an alist describing one instant at one place: the sun's
altitude, bearing and direction, the phase of the day that altitude
falls in, the astronomical season, the local month and hour, and the
calendar periods (holidays and date spans) in effect.  Look rules match
against it."
  (:require [tod.sun :as sun]
            [calendar]
            [holidays]))

(def default-ladder
  "Phases of the day by the sun's minimum altitude in degrees.
Each entry is (PHASE MIN-ALTITUDE), highest first; the last entry
catches everything below the one before it."
  (list (list 'day 6.0)
        (list 'golden-hour -0.833)
        (list 'civil-twilight -6.0)
        (list 'nautical-twilight -12.0)
        (list 'astronomical-twilight -18.0)
        (list 'night -90.0)))

(defn phase-for-altitude
  "Return the phase of LADDER that the sun's ALTITUDE falls in.
LADDER is a list of (PHASE MIN-ALTITUDE), highest first."
  [ladder altitude]
  (let [step (seq-find (fn [s] (>= altitude (second s))) ladder)]
    (first (or step (last ladder)))))

(defn ladder-heights
  "Return the altitudes at which LADDER changes phase.
The lowest step has no lower boundary, so it contributes nothing."
  [ladder]
  (mapcar (fn [s] (second s)) (butlast ladder)))

(defn- date-ordinal
  "Return MONTH * 100 + DAY for the (MONTH DAY ...) list DATE."
  [date]
  (+ (* 100 (nth date 0)) (nth date 1)))

(defn in-span-p
  "Return non-nil when DATE falls within START and END, inclusive.
DATE is (MONTH DAY YEAR); START and END are (MONTH DAY).  A span whose
END comes before its START wraps over the new year."
  [date start end]
  (let [d (date-ordinal date)
        s (date-ordinal start)
        e (date-ordinal end)]
    (if (<= s e)
      (and (<= s d) (<= d e))
      (or (>= d s) (<= d e)))))

(defn span-names
  "Return the names of the SPANS that contain DATE.
Each span is (NAME (MONTH DAY) (MONTH DAY)); DATE is (MONTH DAY YEAR)."
  [date spans]
  (delq nil (mapcar (fn [span]
                      (when (in-span-p date (nth span 1) (nth span 2))
                        (nth span 0)))
                    spans)))

(defn holiday-names
  "Return the names of the holidays in HOLIDAYS that fall on DATE.
HOLIDAYS has the shape of `calendar-holidays'; DATE is (MONTH DAY YEAR)."
  [date holidays]
  (let [calendar-holidays holidays]
    (calendar-check-holidays date)))

(defn local-date
  "Return the (MONTH DAY YEAR) list of TIME in the local time zone."
  [time]
  (let [d (decode-time time)]
    (list (decoded-time-month d) (decoded-time-day d) (decoded-time-year d))))

(defn at
  "Return the moment at TIME for LATITUDE and LONGITUDE.
LADDER is a list of (PHASE MIN-ALTITUDE), highest first.  HOLIDAYS has
the shape of `calendar-holidays' and SPANS is a list of
\\(NAME (MONTH DAY) (MONTH DAY)); both feed the :periods entry."
  [time latitude longitude ladder holidays spans]
  (let [local (decode-time time)
        date (local-date time)
        altitude (sun/altitude time latitude longitude)]
    {:time time
     :latitude latitude
     :longitude longitude
     :altitude altitude
     :azimuth (sun/azimuth time latitude longitude)
     :rising (sun/rising-p time latitude longitude)
     :phase (phase-for-altitude ladder altitude)
     :season (sun/season time latitude)
     :season-progress (sun/season-progress time latitude)
     :date date
     :month (decoded-time-month local)
     :hour (decoded-time-hour local)
     :periods (append (holiday-names date holidays) (span-names date spans))}))

(defn next-change
  "Return the Lisp time of the next phase boundary after TIME, or nil.
LADDER is a list of (PHASE MIN-ALTITUDE), highest first.  Nil means no
boundary is crossed within a day, as in polar day and polar night.
LATITUDE and LONGITUDE are in degrees."
  [time latitude longitude ladder]
  (let [e (sun/next-event time latitude longitude (ladder-heights ladder))]
    (when e (get e :time))))

(defn next-midnight
  "Return the Lisp time of the next local midnight after TIME.
Periods, months and seasons can only change there or at a sun event."
  [time]
  (let [d (decode-time time)]
    (encode-time (list 0 0 0 (+ 1 (decoded-time-day d)) (decoded-time-month d)
                       (decoded-time-year d) nil -1 nil))))
