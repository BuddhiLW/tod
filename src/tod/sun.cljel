(ns tod.sun
  "Sun altitude, twilight crossings and seasons from solar.el.

Everything is computed in universal time with solar.el's internal
functions and returned as Lisp timestamps.  Local time, daylight saving
and time zones are left to the operating system, so the user's calendar
settings are never read or changed.  Solar.el's own day-length guess is
avoided: polar day and polar night are classified by the sun's altitude
at local noon and midnight."
  (:require [solar]))

(defn utc-midnight
  "Return the Lisp time of 00:00 UTC on DAY, a (MONTH DAY YEAR) list."
  [day]
  (encode-time (list 0 0 0 (nth day 1) (nth day 0) (nth day 2) nil nil true)))

(defn utc-date
  "Return the (MONTH DAY YEAR) list of TIME in universal time."
  [time]
  (let [d (decode-time time true)]
    (list (decoded-time-month d) (decoded-time-day d) (decoded-time-year d))))

(defn- utc-hours
  "Return the hours since 00:00 UTC of TIME, as a float."
  [time]
  (let [d (decode-time time true)]
    (/ (+ (* 3600.0 (decoded-time-hour d))
          (* 60.0 (decoded-time-minute d))
          (float (decoded-time-second d)))
       3600.0)))

(defn- horizontal
  "Return solar.el's (AZIMUTH ALTITUDE) of the sun at TIME.
LATITUDE and LONGITUDE are in degrees, north and east positive.
Azimuth follows Meeus: 0 is south and 90 is west."
  [time latitude longitude]
  (let [t0 (solar-julian-ut-centuries (utc-date time))
        solar-sidereal-time-greenwich-midnight (solar-sidereal-time t0)]
    (solar-horizontal-coordinates (list t0 (utc-hours time)) latitude longitude true)))

(defn- normalize-degrees
  "Return the angle DEGREES folded into (-180, 180]."
  [degrees]
  (let [d (mod degrees 360.0)]
    (if (> d 180.0) (- d 360.0) d)))

(defn altitude
  "Return the sun's geometric altitude in degrees at TIME.
LATITUDE and LONGITUDE are in degrees, north and east positive."
  [time latitude longitude]
  (normalize-degrees (nth (horizontal time latitude longitude) 1)))

(defn azimuth
  "Return the sun's compass bearing in degrees at TIME, north being 0.
LATITUDE and LONGITUDE are in degrees, north and east positive."
  [time latitude longitude]
  (mod (+ 180.0 (nth (horizontal time latitude longitude) 0)) 360.0))

(defn rising-p
  "Return non-nil when the sun is climbing at TIME.
LATITUDE and LONGITUDE are in degrees, north and east positive."
  [time latitude longitude]
  (< (altitude time latitude longitude)
     (altitude (time-add time 300) latitude longitude)))

(defn crossings
  "Return (RISE SET) Lisp times when the sun crosses HEIGHT degrees.
The crossings belong to the solar day of DAY, a (MONTH DAY YEAR) list,
at LATITUDE and LONGITUDE.  RISE is the upward crossing before local
solar noon and SET the downward one after it; either is nil when the
sun stays on one side of HEIGHT for that half-day."
  [day latitude longitude height]
  (let [calendar-latitude latitude
        calendar-longitude longitude
        calendar-time-zone 0
        calendar-daylight-time-offset 0
        calendar-daylight-savings-starts nil
        calendar-daylight-savings-ends nil
        solar-northern-spring-or-summer-season nil
        noon (solar-exact-local-noon day)
        t0 (solar-julian-ut-centuries (first noon))
        solar-sidereal-time-greenwich-midnight (solar-sidereal-time t0)
        moment (list t0 (second noon))
        base (utc-midnight (first noon))
        up (solar-moment -1 latitude longitude moment height)
        down (solar-moment 1 latitude longitude moment height)]
    (list (when up (time-add base (round (* up 3600.0))))
          (when down (time-add base (round (* down 3600.0)))))))

(defn- day-events
  "Return the crossing events of DAY for every height in HEIGHTS.
Each event is an alist with :time, :height and :rising.  LATITUDE and
LONGITUDE are in degrees."
  [day latitude longitude heights]
  (mapcan (fn [height]
            (let [pair (crossings day latitude longitude height)]
              (delq nil
                    (list (when (first pair)
                            {:time (first pair) :height height :rising true})
                          (when (second pair)
                            {:time (second pair) :height height :rising false})))))
          heights))

(defn events-around
  "Return the crossing events within a day either side of TIME, sorted.
HEIGHTS lists the altitudes in degrees whose crossings count.  Each
event is an alist with :time, :height and :rising.  LATITUDE and
LONGITUDE are in degrees."
  [time latitude longitude heights]
  (let [dates (list (utc-date (time-subtract time 86400))
                    (utc-date time)
                    (utc-date (time-add time 86400)))
        all (mapcan (fn [day] (day-events day latitude longitude heights)) dates)]
    (sort (fn [a b] (time-less-p (get a :time) (get b :time))) all)))

(defn next-event
  "Return the first crossing event strictly after TIME, or nil.
HEIGHTS lists the altitudes in degrees whose crossings count.
LATITUDE and LONGITUDE are in degrees."
  [time latitude longitude heights]
  (seq-find (fn [e] (time-less-p time (get e :time)))
            (events-around time latitude longitude heights)))

(defn ecliptic-longitude
  "Return the sun's apparent ecliptic longitude in degrees at TIME.
The value is 0 at the March equinox and 180 at the September one."
  [time]
  (let [calendar-time-zone 0
        calendar-daylight-time-offset 0
        calendar-daylight-savings-starts nil
        calendar-daylight-savings-ends nil]
    (solar-longitude (+ 2440587.5 (/ (float-time time) 86400.0)))))

(defn- season-index
  "Return 0 to 3 for the astronomical season at LONGITUDE and LATITUDE.
LONGITUDE is ecliptic.  0 is spring; the southern hemisphere is shifted
by half a year."
  [longitude latitude]
  (let [shifted (if (< latitude 0) (+ longitude 180.0) longitude)]
    (floor (/ (mod shifted 360.0) 90.0))))

(defn season
  "Return the astronomical season at TIME for LATITUDE.
The value is one of the symbols spring, summer, autumn and winter,
counted from the equinoxes and solstices; south of the equator the
seasons are shifted by half a year."
  [time latitude]
  (nth (list 'spring 'summer 'autumn 'winter)
       (season-index (ecliptic-longitude time) latitude)))

(defn season-progress
  "Return how far TIME is through its astronomical season, in [0, 1).
LATITUDE decides the hemisphere, which does not change the fraction."
  [time latitude]
  (let [shifted (if (< latitude 0)
                  (+ (ecliptic-longitude time) 180.0)
                  (ecliptic-longitude time))]
    (/ (mod shifted 90.0) 90.0)))
