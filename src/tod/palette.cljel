(ns tod.palette
  "Contrast-safe palettes from pywal.

pywal picks colours from a wallpaper but knows nothing about what they
will mean in an editor: its slot 1 is not necessarily red, and its
colours are not checked against the background they will sit on.  This
namespace reads pywal's colors.json, gives each semantic colour (red,
orange, yellow, green, cyan, blue, magenta) the palette colour nearest
in hue, synthesizes one when the wallpaper has none close enough, and
repairs every colour to a minimum WCAG contrast against the background."
  (:require [tod.color :as color]
            [tod.process :as process]
            [json]))

(def semantic-hues
  "Semantic colour names and their target hues in degrees."
  (list (list :red 0.0)
        (list :orange 30.0)
        (list :yellow 55.0)
        (list :green 120.0)
        (list :cyan 185.0)
        (list :blue 220.0)
        (list :magenta 295.0)))

(def warm-light
  "Colour mixed into backgrounds while the sun is low."
  "#ff9e3d")

(defn read-wal
  "Return pywal's palette in FILE as an alist, or nil when unreadable.
The alist has :background, :foreground, :cursor, :wallpaper and :colors,
the sixteen colours color0 to color15 in order."
  [file]
  (when (and file (file-readable-p file))
    (condition-case nil
        (let [data (with-temp-buffer
                     (insert-file-contents file)
                     (json-parse-buffer :object-type 'alist :array-type 'list))
              special (alist-get 'special data)
              colors (alist-get 'colors data)]
          {:background (alist-get 'background special)
           :foreground (alist-get 'foreground special)
           :cursor (alist-get 'cursor special)
           :wallpaper (alist-get 'wallpaper data)
           :colors (mapcar (fn [i] (alist-get (intern (format "color%d" i)) colors))
                           (number-sequence 0 15))})
      (error nil))))

(defn accent-candidates
  "Return the saturated accent colours of the pywal palette WAL.
Slots 0, 7, 8 and 15 hold the background, foreground and greys."
  [wal]
  (let [colors (get wal :colors)]
    (seq-filter (fn [c] (and (color/hex-to-rgb c) (>= (color/saturation c) 0.15)))
                (mapcar (fn [i] (nth colors i)) (list 1 2 3 4 5 6 9 10 11 12 13 14)))))

(defn nearest-accent
  "Return the colour of CANDIDATES nearest in hue to HUE, or nil.
Colours more than 40 degrees away do not count."
  [candidates hue]
  (let [scored (mapcar (fn [c] (cons (color/hue-distance (color/hue-degrees c) hue) c)) candidates)
        best (car (sort (fn [a b] (< (car a) (car b))) scored))]
    (when (and best (<= (car best) 40.0))
      (cdr best))))

(defn tint
  "Return WAL with its background warmed towards low sunlight.
PHASE is the phase of the day; golden-hour and civil-twilight get
WARMTH of the warm light mixed in, other phases none."
  [wal phase warmth]
  (if (and (memq phase (list 'golden-hour 'civil-twilight)) (> warmth 0.0))
    (cons (cons :background (color/mix (get wal :background) warm-light warmth)) wal)
    wal))

(defn semantic
  "Return a semantic palette from the pywal palette WAL.
Every accent reaches RATIO against the background and the foreground
reaches at least 7.  Keys are :bg, :fg, :cursor, :comment and the names
in `tod-palette-semantic-hues'."
  [wal ratio]
  (let [bg (or (get wal :background) "#000000")
        fg (color/ensure-contrast (or (get wal :foreground) (if (color/dark-p bg) "#ffffff" "#000000"))
                                  bg (max ratio 7.0))
        candidates (accent-candidates wal)
        accents (mapcar (fn [entry]
                          (let [hue (second entry)
                                base (or (nearest-accent candidates hue)
                                         (color/from-hsl (/ hue 360.0) 0.55 0.5))]
                            (cons (first entry) (color/ensure-contrast base bg ratio))))
                        semantic-hues)
        grey (or (nth (get wal :colors) 8) (color/mix fg bg 0.45))]
    (append (list (cons :bg bg)
                  (cons :fg fg)
                  (cons :cursor (color/ensure-contrast (or (get wal :cursor) fg) bg 3.0))
                  (cons :comment (color/ensure-contrast grey bg ratio)))
            accents)))

(defn wal-colors-file
  "Return where pywal writes colors.json for CACHE-DIR.
When SYSTEM is non-nil pywal uses its global cache, which also recolours
terminals and other programs; otherwise it writes under CACHE-DIR."
  [cache-dir system]
  (if system
    (expand-file-name "wal/colors.json" (or (getenv "XDG_CACHE_HOME") (expand-file-name "~/.cache")))
    (expand-file-name "wal/colors.json" cache-dir)))

(defn wal-commands
  "Return the commands that make pywal derive a palette from IMAGE.
LIGHT asks for a light scheme.  When SYSTEM is nil pywal is kept to
CACHE-DIR and told not to touch terminals, the wallpaper or other
programs; when non-nil it recolours the desktop as pywal usually does."
  [image cache-dir light system]
  (let [flags (append (list "-i" (expand-file-name image) "-n" "-q")
                      (when light (list "-l")))]
    (if system
      (list (append (list "wal") flags))
      (list (append (list "env" (str "PYWAL_CACHE_DIR=" (expand-file-name "wal" cache-dir)) "NO_FUN=1" "wal")
                    flags
                    (list "-s" "-t" "-e"))))))

(defn generate
  "Derive a pywal palette from IMAGE, then call DONE with it.
DONE receives the palette from `tod-palette-read-wal' and an error
message, one of them nil.  CACHE-DIR, LIGHT and SYSTEM are as for
`tod-palette-wal-commands'."
  [image cache-dir light system done]
  (let [out (wal-colors-file cache-dir system)]
    (process/run 'palette
                 (wal-commands image cache-dir light system)
                 (fn [ok message]
                   (let [wal (when ok (read-wal out))]
                     (funcall done wal (cond
                                         (not ok) message
                                         (null wal) (str "pywal wrote no palette to " out)
                                         :else nil)))))))
