(ns tod.color
  "Colour arithmetic for contrast-safe palettes.

Hex parsing, WCAG 2 relative luminance and contrast ratio, blending,
and lightness repair in HSL.  Everything works on numbers and
\"#rrggbb\" strings, so no display is needed."
  (:require [color]))

(defn hex-to-rgb
  "Return the (R G B) floats in [0, 1] for the hex colour HEX.
HEX is \"#rrggbb\" or \"#rgb\"; anything else returns nil."
  [hex]
  (cond
    (not (stringp hex)) nil

    (string-match-p "\\`#[0-9a-fA-F]\\{6\\}\\'" hex)
    (list (/ (string-to-number (substring hex 1 3) 16) 255.0)
          (/ (string-to-number (substring hex 3 5) 16) 255.0)
          (/ (string-to-number (substring hex 5 7) 16) 255.0))

    (string-match-p "\\`#[0-9a-fA-F]\\{3\\}\\'" hex)
    (list (/ (* 17 (string-to-number (substring hex 1 2) 16)) 255.0)
          (/ (* 17 (string-to-number (substring hex 2 3) 16)) 255.0)
          (/ (* 17 (string-to-number (substring hex 3 4) 16)) 255.0))

    :else nil))

(defn- clamp01
  "Clamp the number X into [0, 1]."
  [x]
  (max 0.0 (min 1.0 x)))

(defn rgb-to-hex
  "Return the \"#rrggbb\" string for the float channels R, G and B."
  [r g b]
  (format "#%02x%02x%02x"
          (round (* 255.0 (clamp01 r)))
          (round (* 255.0 (clamp01 g)))
          (round (* 255.0 (clamp01 b)))))

(defn- rgb-list-to-hex
  "Return the hex string for RGB, a list of three float channels."
  [rgb]
  (rgb-to-hex (nth rgb 0) (nth rgb 1) (nth rgb 2)))

(defn- linear-channel
  "Return the linearised value of the sRGB channel C."
  [c]
  (if (<= c 0.04045)
    (/ c 12.92)
    (expt (/ (+ c 0.055) 1.055) 2.4)))

(defn luminance
  "Return the WCAG 2 relative luminance of the hex colour HEX.
Unparseable colours count as black."
  [hex]
  (let [rgb (or (hex-to-rgb hex) (list 0.0 0.0 0.0))]
    (+ (* 0.2126 (linear-channel (nth rgb 0)))
       (* 0.7152 (linear-channel (nth rgb 1)))
       (* 0.0722 (linear-channel (nth rgb 2))))))

(defn contrast
  "Return the WCAG 2 contrast ratio between hex colours A and B.
The result lies in [1, 21]."
  [a b]
  (let [la (luminance a)
        lb (luminance b)]
    (/ (+ (max la lb) 0.05)
       (+ (min la lb) 0.05))))

(defn dark-p
  "Return non-nil when the hex colour HEX reads as a dark background.
Dark means white text contrasts with HEX more than black text does."
  [hex]
  (< (luminance hex) 0.179))

(defn mix
  "Return the hex colour that is FRACTION of the way from A to B.
FRACTION 0.0 gives A and 1.0 gives B; the blend is linear in sRGB."
  [a b fraction]
  (let [ra (or (hex-to-rgb a) (list 0.0 0.0 0.0))
        rb (or (hex-to-rgb b) (list 0.0 0.0 0.0))
        f (clamp01 fraction)]
    (rgb-to-hex (+ (nth ra 0) (* f (- (nth rb 0) (nth ra 0))))
                (+ (nth ra 1) (* f (- (nth rb 1) (nth ra 1))))
                (+ (nth ra 2) (* f (- (nth rb 2) (nth ra 2)))))))

(defn to-hsl
  "Return the (HUE SATURATION LIGHTNESS) floats in [0, 1] of hex HEX."
  [hex]
  (let [rgb (or (hex-to-rgb hex) (list 0.0 0.0 0.0))]
    (color-rgb-to-hsl (nth rgb 0) (nth rgb 1) (nth rgb 2))))

(defn from-hsl
  "Return the hex colour for HUE, SATURATION and LIGHTNESS in [0, 1]."
  [hue saturation lightness]
  (rgb-list-to-hex (color-hsl-to-rgb hue (clamp01 saturation) (clamp01 lightness))))

(defn hue-degrees
  "Return the hue of hex colour HEX in degrees, in [0, 360)."
  [hex]
  (* 360.0 (nth (to-hsl hex) 0)))

(defn saturation
  "Return the HSL saturation of hex colour HEX, in [0, 1]."
  [hex]
  (nth (to-hsl hex) 1))

(defn hue-distance
  "Return the circular distance in degrees between hues A and B."
  [a b]
  (let [d (abs (- (mod a 360.0) (mod b 360.0)))]
    (min d (- 360.0 d))))

(defn with-lightness
  "Return hex colour HEX with its HSL lightness replaced by LIGHTNESS."
  [hex lightness]
  (let [hsl (to-hsl hex)]
    (from-hsl (nth hsl 0) (nth hsl 1) lightness)))

(defn- search-lightness
  "Return the lightness nearest FROM, towards TARGET, reaching RATIO.
Binary search over lightness for HEX against background BG.  TARGET is
0.0 or 1.0.  Returns TARGET when no lightness in between is enough."
  [hex bg ratio from target]
  (loop [near from
         far target
         i 0]
    (if (>= i 24)
      far
      (let [mid (/ (+ near far) 2.0)]
        (if (>= (contrast (with-lightness hex mid) bg) ratio)
          (recur near mid (+ i 1))
          (recur mid far (+ i 1)))))))

(defn ensure-contrast
  "Return FG adjusted so that its contrast with BG is at least RATIO.
Only HSL lightness changes, so the hue survives.  FG moves away from
the background: lighter on dark backgrounds, darker on light ones.
When even white or black cannot reach RATIO, the extreme is returned."
  [fg bg ratio]
  (if (>= (contrast fg bg) ratio)
    fg
    (let [hsl (to-hsl fg)
          target (if (dark-p bg) 1.0 0.0)]
      (with-lightness fg (search-lightness fg bg ratio (nth hsl 2) target)))))
