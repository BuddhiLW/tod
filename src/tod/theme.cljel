(ns tod.theme
  "Switching Emacs themes, and themes generated from palettes.

A switch enables the new theme first and then disables the other colour
scheme themes, so the frame never passes through the default colours,
and themes that are not colour schemes (bundles of settings) are left
alone.  Generated themes are declared at runtime; with modus-themes 5.2
or later the palette is expanded into a full modus theme, otherwise a
compact set of faces is written directly."
  (:require [tod.color :as color]))

(declare-function modus-themes-generate-palette "modus-themes")
(declare-function modus-themes-theme "modus-themes")

(defvar tod-theme--applying nil
  "Non-nil while tod itself is enabling or disabling themes.")

(defvar tod-theme-palette nil
  "Modus palette of the theme generated by tod.")

(defvar tod-theme-palette-user nil
  "User additions to `tod-theme-palette'.")

(defvar tod-theme-palette-overrides nil
  "Overrides for `tod-theme-palette'.")

(defn color-scheme-p
  "Return non-nil when THEME is a colour scheme.
Themes that do not declare their :kind are assumed to be one."
  [theme]
  (memq (plist-get (elisp/get theme 'theme-properties) :kind) (list 'color-scheme nil)))

(defn loaded-p
  "Return non-nil when THEME has been loaded and has settings."
  [theme]
  (elisp/get theme 'theme-settings))

(defn available-p
  "Return non-nil when THEME can be enabled without being installed."
  [theme]
  (and (symbolp theme)
       (or (loaded-p theme) (memq theme (custom-available-themes)))))

(defn enabled-alone-p
  "Return non-nil when THEME is the only colour scheme enabled."
  [theme]
  (and (memq theme custom-enabled-themes)
       (not (seq-some (fn [th] (and (not (eq th theme)) (color-scheme-p th)))
                      custom-enabled-themes))))

(defn switch
  "Make THEME the only enabled colour scheme and return it.
THEME is enabled before the others are disabled, which avoids a flash
of default colours; it is loaded first when it has no settings yet."
  [theme]
  (when-not (enabled-alone-p theme)
    (let [tod-theme--applying true]
      (if (loaded-p theme)
        (enable-theme theme)
        (load-theme theme true))
      (doseq [th (remq theme custom-enabled-themes)]
        (when (color-scheme-p th)
          (disable-theme th)))))
  theme)

(defn- modus-generator-p
  "Return non-nil when modus-themes can build a theme from a palette."
  []
  (and (or (require 'modus-themes nil true) (require-theme 'modus-themes true))
       (fboundp 'modus-themes-generate-palette)
       (fboundp 'modus-themes-theme)
       (not (macrop 'modus-themes-theme))))

(defn- modus-base
  "Return the base colours modus-themes derives a theme from PALETTE with."
  [palette]
  (list (list 'bg-main (get palette :bg))
        (list 'fg-main (get palette :fg))
        (list 'cursor (get palette :cursor))
        (list 'red (get palette :red))
        (list 'green (get palette :green))
        (list 'yellow (get palette :yellow))
        (list 'blue (get palette :blue))
        (list 'magenta (get palette :magenta))
        (list 'cyan (get palette :cyan))))

(defn- spec
  "Return the face spec for FACE with the attribute plist ATTRS."
  [face attrs]
  (list face (list (cons true attrs))))

(defn- readable-background
  "Return a background near BG tinted towards TINT that keeps FG legible.
The tint is reduced until FG reaches a contrast of 4.5 on it."
  [bg tint fg]
  (let [candidate (seq-find (fn [f] (>= (color/contrast fg (color/mix bg tint f)) 4.5))
                            (list 0.35 0.25 0.18 0.12 0.08 0.0))]
    (color/mix bg tint (or candidate 0.0))))

(defn palette-faces
  "Return the face specs for a compact theme built from PALETTE."
  [palette]
  (let [bg (get palette :bg)
        fg (get palette :fg)
        dim (get palette :comment)
        region (readable-background bg (get palette :blue) fg)
        subtle (color/mix bg fg 0.07)
        bar (color/mix bg fg 0.14)]
    (list (spec 'default (list :background bg :foreground fg))
          (spec 'cursor (list :background (get palette :cursor)))
          (spec 'region (list :background region :extend true))
          (spec 'hl-line (list :background subtle :extend true))
          (spec 'fringe (list :background bg))
          (spec 'vertical-border (list :foreground bar))
          (spec 'mode-line (list :background bar :foreground fg))
          (spec 'mode-line-inactive (list :background subtle :foreground dim))
          (spec 'minibuffer-prompt (list :foreground (get palette :blue) :weight 'bold))
          (spec 'link (list :foreground (get palette :blue) :underline true))
          (spec 'shadow (list :foreground dim))
          (spec 'error (list :foreground (get palette :red) :weight 'bold))
          (spec 'warning (list :foreground (get palette :orange) :weight 'bold))
          (spec 'success (list :foreground (get palette :green) :weight 'bold))
          (spec 'font-lock-comment-face (list :foreground dim :slant 'italic))
          (spec 'font-lock-doc-face (list :foreground dim))
          (spec 'font-lock-string-face (list :foreground (get palette :green)))
          (spec 'font-lock-keyword-face (list :foreground (get palette :magenta)))
          (spec 'font-lock-builtin-face (list :foreground (get palette :magenta)))
          (spec 'font-lock-function-name-face (list :foreground (get palette :blue)))
          (spec 'font-lock-variable-name-face (list :foreground (get palette :cyan)))
          (spec 'font-lock-type-face (list :foreground (get palette :yellow)))
          (spec 'font-lock-constant-face (list :foreground (get palette :orange)))
          (spec 'font-lock-warning-face (list :foreground (get palette :red)))
          (spec 'line-number (list :foreground dim :background bg))
          (spec 'line-number-current-line (list :foreground fg :weight 'bold))
          (spec 'show-paren-match (list :background (readable-background bg (get palette :cyan) fg)))
          (spec 'isearch (list :background (readable-background bg (get palette :yellow) fg) :weight 'bold))
          (spec 'lazy-highlight (list :background (readable-background bg (get palette :cyan) fg))))))

(defn define-palette-theme
  "Define or redefine the theme NAME from PALETTE and return NAME.
PALETTE comes from `tod-palette-semantic'.  When NAME is already enabled
its new colours take effect at once."
  [name palette]
  (let [mode (if (color/dark-p (get palette :bg)) 'dark 'light)]
    (if (modus-generator-p)
      (progn
        (setq tod-theme-palette (modus-themes-generate-palette (modus-base palette)))
        (modus-themes-theme name 'tod "Generated by tod from the wallpaper." mode
                            'tod-theme-palette 'tod-theme-palette-user 'tod-theme-palette-overrides))
      (progn
        (custom-declare-theme name (intern (str (symbol-name name) "-theme"))
                              "Generated by tod from the wallpaper."
                              (list :kind 'color-scheme :background-mode mode :family 'tod))
        (apply #'custom-theme-set-faces name (palette-faces palette))
        (custom-theme-set-variables name (list 'frame-background-mode (list 'quote mode)))))
    (when (memq name custom-enabled-themes)
      (let [tod-theme--applying true]
        (enable-theme name)))
    name))
