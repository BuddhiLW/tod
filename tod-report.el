(eval-and-compile
  (require 'clel)
  (unless (and (boundp 'clel-runtime-version)
               (version<= "0.8.0" clel-runtime-version))
    (error "Installed clel runtime %s is too old for this file (needs %s)"
           (if (boundp 'clel-runtime-version)
               clel-runtime-version
             "(pre-0.8.0)")
           "0.8.0")))
(require 'tod-sky)

(defun tod-report-label (sym)
  "Return a readable name for the symbol SYM, capitalised."
  (let* ((words (string-replace "-" " " (symbol-name sym))))
    (clel-str (upcase (substring words 0 1)) (substring words 1))))

(defun tod-report-sky-lines (moment)
  "Return the lines describing the moon, the signs and the hour of MOMENT."
  (let* ((hour (clel-get moment :planetary-hour)))
    (list
     (format "Moon       %s, %d%% lit, %.1f days old, %s (%.0f° altitude)"
             (tod-report-label (clel-get moment :moon-phase))
             (round (* 100 (clel-get moment :illumination)))
             (clel-get moment :moon-age)
             (if (clel-get moment :moon-up) "up" "down")
             (clel-get moment :moon-altitude))
     (format "Sun sign   %s %d°, decan %d, %s %s"
             (tod-report-label (clel-get moment :zodiac))
             (floor (clel-get moment :zodiac-degree))
             (clel-get moment :decan)
             (clel-get moment :modality)
             (clel-get moment :element))
     (format "Moon sign  %s" (tod-report-label (clel-get moment :moon-sign)))
     (format "Day ruler  %s" (tod-report-label (clel-get moment :day-ruler)))
     (format "Hour       %s, planetary hour %d of 24 (%s to %s)"
             (tod-report-label (clel-get moment :planet))
             (clel-get hour :hour)
             (format-time-string "%R" (clel-get hour :start))
             (format-time-string "%R" (clel-get hour :end))))))

(defun tod-report-hour-lines (time latitude longitude n)
  "Return \"HH:MM Planet\" lines for the planetary hours from TIME.
N hours are listed, at LATITUDE and LONGITUDE."
  (cl-labels ((recur (from i acc)
                     (if (>= i n)
                         (nreverse acc)
                       (let* ((h
                               (tod-sky-planetary-hour from
                                                       latitude
                                                       longitude)))
                         (recur
                          (time-add (clel-get h :end) 1)
                          (+ i 1)
                          (cons
                           (format
                            "%s %-8s%s"
                            (format-time-string "%R" (clel-get h :start))
                            (tod-report-label (clel-get h :planet))
                            (if (clel-get h :daytime) "" " (night)"))
                           acc))))))
    (recur time 0 nil)))

(provide 'tod-report)
