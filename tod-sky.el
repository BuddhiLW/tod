(defvar tod-sky-synodic-month 29.530588853
  "Mean length of the lunar cycle in days.")

(defvar tod-sky-signs
    (list 'aries
          'taurus
          'gemini
          'cancer
          'leo
          'virgo
          'libra
          'scorpio
          'sagittarius
          'capricorn
          'aquarius
          'pisces)
  "The twelve tropical signs, from 0 degrees of ecliptic longitude.")

(defvar tod-sky-sign-rulers
    (list 'mars
          'venus
          'mercury
          'moon
          'sun
          'mercury
          'venus
          'mars
          'jupiter
          'saturn
          'saturn
          'jupiter)
  "The traditional ruler of each sign, in the order of `tod-sky-signs'.")

(defvar tod-sky-elements (list 'fire 'earth 'air 'water)
  "Elements of the signs, repeating from aries.")

(defvar tod-sky-modalities (list 'cardinal 'fixed 'mutable)
  "Modalities of the signs, repeating from aries.")

(defvar tod-sky-chaldean-order
    (list 'saturn 'jupiter 'mars 'sun 'venus 'mercury 'moon)
  "The classical planets from slowest to fastest.")

(defvar tod-sky-day-rulers
    (list 'sun 'moon 'mars 'mercury 'jupiter 'venus 'saturn)
  "The planet of each weekday, Sunday first.")

(defvar tod-sky-moon-phases
    (list 'new-moon
          'waxing-crescent
          'first-quarter
          'waxing-gibbous
          'full-moon
          'waning-gibbous
          'last-quarter
          'waning-crescent)
  "Names of the eight lunar phases, starting at new moon.
Each phase spans 45 degrees of elongation.")

(defun tod-sky--rad (degrees)
  "Return DEGREES in radians."
  (degrees-to-radians degrees))

(defun tod-sky--deg (radians)
  "Return RADIANS in degrees."
  (radians-to-degrees radians))

(defun tod-sky--sind (degrees)
  "Return the sine of DEGREES."
  (sin (tod-sky--rad degrees)))

(defun tod-sky--cosd (degrees)
  "Return the cosine of DEGREES."
  (cos (tod-sky--rad degrees)))

(defun tod-sky-julian-day (time)
  "Return the Julian day of the Lisp time TIME."
  (+ 2440587.5 (/ (float-time time) 86400.0)))

(defun tod-sky--centuries (time)
  "Return Julian centuries since J2000.0 at TIME."
  (/ (- (tod-sky-julian-day time) 2451545.0) 36525.0))

(defun tod-sky-moon-ecliptic (time)
  "Return the moon's geocentric (LONGITUDE LATITUDE) in degrees at TIME."
  (let* ((c (tod-sky--centuries time))
         (lp (+ 218.3164477 (* 481267.88123421 c)))
         (d (+ 297.8501921 (* 445267.1114034 c)))
         (m (+ 357.5291092 (* 35999.0502909 c)))
         (mp (+ 134.9633964 (* 477198.8675055 c)))
         (f (+ 93.272095 (* 483202.0175233 c)))
         (lon
          (+ lp
             (* 6.288774 (tod-sky--sind mp))
             (* 1.274027 (tod-sky--sind (- (* 2 d) mp)))
             (* 0.658314 (tod-sky--sind (* 2 d)))
             (* 0.213618 (tod-sky--sind (* 2 mp)))
             (* -0.185116 (tod-sky--sind m))
             (* -0.114332 (tod-sky--sind (* 2 f)))
             (* 0.058793 (tod-sky--sind (- (* 2 d) (* 2 mp))))
             (* 0.057066 (tod-sky--sind (- (* 2 d) m mp)))
             (* 0.053322 (tod-sky--sind (+ (* 2 d) mp)))
             (* 0.045758 (tod-sky--sind (- (* 2 d) m)))
             (* -0.040923 (tod-sky--sind (- m mp)))
             (* -0.03472 (tod-sky--sind d))
             (* -0.030383 (tod-sky--sind (+ m mp)))))
         (lat
          (+ (* 5.128122 (tod-sky--sind f))
             (* 0.280602 (tod-sky--sind (+ mp f)))
             (* 0.277693 (tod-sky--sind (- mp f)))
             (* 0.173237 (tod-sky--sind (- (* 2 d) f)))
             (* 0.055413 (tod-sky--sind (+ (- (* 2 d) f) mp)))
             (* 0.046271 (tod-sky--sind (- (* 2 d) f mp))))))
    (list (mod lon 360.0) lat)))

(defun tod-sky-moon-longitude (time)
  "Return the moon's ecliptic longitude in degrees at TIME."
  (clel-first (tod-sky-moon-ecliptic time)))

(defun tod-sky-elongation (time)
  "Return how far the moon has moved east of the sun at TIME, in degrees.
0 is new moon, 90 first quarter, 180 full and 270 last quarter."
  (mod (- (tod-sky-moon-longitude time) (tod-sun-ecliptic-longitude time))
       360.0))

(defun tod-sky-illumination (time)
  "Return the illuminated fraction of the moon's disc at TIME, in [0, 1]."
  (/ (- 1.0 (tod-sky--cosd (tod-sky-elongation time))) 2.0))

(defun tod-sky-moon-age (time)
  "Return the days since the last new moon at TIME."
  (* tod-sky-synodic-month (/ (tod-sky-elongation time) 360.0)))

(defun tod-sky-phase-for-elongation (elongation)
  "Return the lunar phase symbol for ELONGATION in degrees."
  (clel-nth tod-sky-moon-phases (mod (floor (/ (+ elongation 22.5) 45.0)) 8)))

(defun tod-sky-moon-phase (time)
  "Return the lunar phase at TIME, one of `tod-sky-moon-phases'."
  (tod-sky-phase-for-elongation (tod-sky-elongation time)))

(defun tod-sky--obliquity (time)
  "Return the mean obliquity of the ecliptic in degrees at TIME."
  (- 23.4392911 (* 0.0130042 (tod-sky--centuries time))))

(defun tod-sky-sidereal-degrees (time longitude)
  "Return the local mean sidereal time at TIME and LONGITUDE, in degrees."
  (let* ((d (- (tod-sky-julian-day time) 2451545.0)))
    (mod (+ 280.46061837 (* 360.98564736629 d) longitude) 360.0)))

(defun tod-sky-ecliptic-altitude (time lon lat latitude longitude)
  "Return the altitude in degrees of the ecliptic point LON, LAT at TIME.
LATITUDE and LONGITUDE give the observer, in degrees."
  (let* ((eps (tod-sky--obliquity time))
         (ra
          (tod-sky--deg
           (atan
            (- (* (tod-sky--sind lon) (tod-sky--cosd eps))
               (* (tan (tod-sky--rad lat)) (tod-sky--sind eps)))
            (tod-sky--cosd lon))))
         (declination
          (tod-sky--deg
           (asin
            (+ (* (tod-sky--sind lat) (tod-sky--cosd eps))
               (* (tod-sky--cosd lat)
                  (tod-sky--sind eps)
                  (tod-sky--sind lon))))))
         (hour-angle (- (tod-sky-sidereal-degrees time longitude) ra)))
    (tod-sky--deg
     (asin
      (+ (* (tod-sky--sind latitude) (tod-sky--sind declination))
         (* (tod-sky--cosd latitude)
            (tod-sky--cosd declination)
            (tod-sky--cosd hour-angle)))))))

(defun tod-sky-moon-altitude (time latitude longitude)
  "Return the moon's geocentric altitude in degrees at TIME.
LATITUDE and LONGITUDE are in degrees, north and east positive."
  (let* ((pos (tod-sky-moon-ecliptic time)))
    (tod-sky-ecliptic-altitude time
                               (clel-first pos)
                               (clel-second pos)
                               latitude
                               longitude)))

(defun tod-sky-sign-index (longitude)
  "Return 0 to 11 for the tropical sign holding ecliptic LONGITUDE."
  (mod (floor (/ (mod longitude 360.0) 30.0)) 12))

(defun tod-sky-sign (longitude)
  "Return the tropical sign symbol holding ecliptic LONGITUDE."
  (clel-nth tod-sky-signs (tod-sky-sign-index longitude)))

(defun tod-sky-sign-degree (longitude)
  "Return how many degrees LONGITUDE lies into its sign, in [0, 30)."
  (mod (mod longitude 360.0) 30.0))

(defun tod-sky-decan (longitude)
  "Return 1, 2 or 3 for the decan of its sign that LONGITUDE falls in."
  (+ 1 (floor (/ (tod-sky-sign-degree longitude) 10.0))))

(defun tod-sky-element (longitude)
  "Return the element of the sign holding ecliptic LONGITUDE."
  (clel-nth tod-sky-elements (mod (tod-sky-sign-index longitude) 4)))

(defun tod-sky-modality (longitude)
  "Return the modality of the sign holding ecliptic LONGITUDE."
  (clel-nth tod-sky-modalities (mod (tod-sky-sign-index longitude) 3)))

(defun tod-sky-sign-ruler (longitude)
  "Return the traditional ruler of the sign holding ecliptic LONGITUDE."
  (clel-nth tod-sky-sign-rulers (tod-sky-sign-index longitude)))

(defun tod-sky-hour-ruler (day-ruler n)
  "Return the planet ruling hour N, counted from 0 at sunrise.
DAY-RULER is the planet of the weekday; hours follow Chaldean order."
  (let* ((start (seq-position tod-sky-chaldean-order day-ruler)))
    (clel-nth tod-sky-chaldean-order (mod (+ start n) 7))))

(defun tod-sky-weekday-ruler (time)
  "Return the planet of the local weekday of TIME."
  (clel-nth tod-sky-day-rulers (decoded-time-weekday (decode-time time))))

(defun tod-sky--sun-events (time latitude longitude)
  "Return the sunrise and sunset events within a day either side of TIME.
LATITUDE and LONGITUDE are in degrees."
  (tod-sun-events-around time latitude longitude (list -0.833)))

(defun tod-sky--clock-hours (time)
  "Return the planetary hour at TIME by equal clock hours from 06:00.
Used where the sun neither rises nor sets."
  (let* ((d (decode-time time))
         (start
          (encode-time
           (list 0
                 0
                 6
                 (decoded-time-day d)
                 (decoded-time-month d)
                 (decoded-time-year d)
                 nil
                 -1
                 nil)))
         (base (if (time-less-p time start) (time-subtract start 86400) start))
         (n (floor (/ (float-time (time-subtract time base)) 3600.0)))
         (hour-start (time-add base (* 3600 n))))
    (clel-array-map :planet (tod-sky-hour-ruler (tod-sky-weekday-ruler base) n)
                    :day-ruler (tod-sky-weekday-ruler base)
                    :hour (+ 1 n)
                    :daytime (< n 12)
                    :start hour-start
                    :end (time-add hour-start 3600))))

(defun tod-sky-planetary-hour (time latitude longitude)
  "Return the planetary hour at TIME for LATITUDE and LONGITUDE.
The value is an alist with :planet, the ruler of the hour; :day-ruler,
the planet of the day that began at the last sunrise; :hour, from 1 at
sunrise to 24; :daytime; and :start and :end as Lisp times."
  (let* ((events (tod-sky--sun-events time latitude longitude))
         (before
          (seq-filter (lambda (e) (not (time-less-p time (clel-get e :time))))
                      events))
         (prev (clel-last before))
         (following
          (seq-find (lambda (e) (time-less-p time (clel-get e :time))) events))
         (rise
          (clel-last (seq-filter (lambda (e) (clel-get e :rising)) before))))
    (if (and prev following rise)
        (let* ((from (clel-get prev :time))
               (span
                (float-time (time-subtract (clel-get following :time) from)))
               (step (/ span 12.0))
               (index
                (min 11
                     (floor (/ (float-time (time-subtract time from)) step))))
               (daytime (clel-get prev :rising))
               (n (+ index (if daytime 0 12)))
               (ruler (tod-sky-weekday-ruler (clel-get rise :time)))
               (start (time-add from (* index step))))
          (clel-array-map :planet (tod-sky-hour-ruler ruler n)
                          :day-ruler ruler
                          :hour (+ 1 n)
                          :daytime daytime
                          :start start
                          :end (time-add start step)))
      (tod-sky--clock-hours time))))

(defun tod-sky-at (time latitude longitude)
  "Return the sky at TIME for LATITUDE and LONGITUDE as an alist.
Keys are :moon-phase, :illumination, :moon-age, :moon-altitude,
:moon-up, :zodiac, :zodiac-degree, :decan, :element, :modality,
:moon-sign, :planet, :day-ruler and :planetary-hour, the whole alist
from `tod-sky-planetary-hour'."
  (let* ((sun-lon (tod-sun-ecliptic-longitude time))
         (moon-pos (tod-sky-moon-ecliptic time))
         (elong (mod (- (clel-first moon-pos) sun-lon) 360.0))
         (moon-alt
          (tod-sky-ecliptic-altitude time
                                     (clel-first moon-pos)
                                     (clel-second moon-pos)
                                     latitude
                                     longitude))
         (hour (tod-sky-planetary-hour time latitude longitude)))
    (clel-array-map :moon-phase (tod-sky-phase-for-elongation elong)
                    :illumination (/ (- 1.0 (tod-sky--cosd elong)) 2.0)
                    :moon-age (* tod-sky-synodic-month (/ elong 360.0))
                    :moon-altitude moon-alt
                    :moon-up (> moon-alt 0.0)
                    :zodiac (tod-sky-sign sun-lon)
                    :zodiac-degree (tod-sky-sign-degree sun-lon)
                    :decan (tod-sky-decan sun-lon)
                    :element (tod-sky-element sun-lon)
                    :modality (tod-sky-modality sun-lon)
                    :moon-sign (tod-sky-sign (clel-first moon-pos))
                    :planet (clel-get hour :planet)
                    :day-ruler (clel-get hour :day-ruler)
                    :planetary-hour hour)))

