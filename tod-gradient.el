;;; Commentary:

;; The background is interpolated along the sun's altitude between
;; keyframes, one ladder for the dark side of the horizon and one for the
;; light side, so the editor drifts from midnight blue through violet
;; twilight and amber golden hour to clear noon.  A setting sun is warmer
;; than a rising one, a bright moon above the horizon silvers the night,
;; the element of the sun's sign tints the background, accents warm while
;; the sun is low, and the cursor takes the colour of the planet ruling the
;; hour.  Every colour is then repaired to readable contrast by
;; `tod-palette-semantic'.

;;; Code:

(eval-and-compile
  (require 'clel)
  (unless (and (boundp 'clel-runtime-version)
               (version<= "0.8.0" clel-runtime-version))
    (error "Installed clel runtime %s is too old for this file (needs %s)"
           (if (boundp 'clel-runtime-version)
               clel-runtime-version
             "(pre-0.8.0)")
           "0.8.0")))
(require 'tod-color)
(require 'tod-palette)
(require 'tod-theme)

(defvar tod-gradient-dark-keyframes
    (list (list -90.0 "#04050b")
          (list -45.0 "#090c1a")
          (list -18.0 "#0f1630")
          (list -12.0 "#131d3a")
          (list -6.0 "#1d1c3c")
          (list -3.0 "#2a203d")
          (list 0.0 "#34232f"))
  "Backgrounds below the horizon as (ALTITUDE HEX), lowest first.")

(defvar tod-gradient-light-keyframes
    (list (list 0.0 "#f2dcc4")
          (list 3.0 "#f5e5d0")
          (list 6.0 "#f7ecdc")
          (list 15.0 "#f6f0e4")
          (list 30.0 "#f2f3ef")
          (list 60.0 "#ecf1f8")
          (list 90.0 "#e6eefb"))
  "Backgrounds above the horizon as (ALTITUDE HEX), lowest first.")

(defvar tod-gradient-setting-tint "#4a1c1c"
  "Colour a sinking sun mixes into twilight backgrounds.")

(defvar tod-gradient-rising-tint "#1f2f4a"
  "Colour a climbing sun mixes into twilight backgrounds.")

(defvar tod-gradient-moonlight "#2a3346"
  "Colour a bright moon mixes into the night.")

(defvar tod-gradient-element-colors
    (list (cons 'fire "#ff6a2b")
          (cons 'earth "#7c8f4e")
          (cons 'air "#a9c4ff")
          (cons 'water "#2f7fd6"))
  "Alist of the tint of each element of the sun's sign.")

(defvar tod-gradient-planet-colors
    (list (cons 'sun "#f2b705")
          (cons 'moon "#c9d1e0")
          (cons 'mars "#e0412b")
          (cons 'mercury "#3fb6a8")
          (cons 'jupiter "#5b6ee1")
          (cons 'venus "#4fbf6a")
          (cons 'saturn "#8a6db3"))
  "Alist of the colour of each classical planet, used for the cursor.")

(defun tod-gradient-interpolate (keyframes altitude)
  "Return the colour of KEYFRAMES at ALTITUDE, blending neighbours.
KEYFRAMES is a list of (ALTITUDE HEX), lowest altitude first; outside
its range the nearest end is used."
  (cl-labels ((recur (frames)
                     (let* ((a (clel-first frames)) (b (clel-second frames)))
                       (cond
                        ((null b) (clel-second a))
                        ((< altitude (clel-first a)) (clel-second a))
                        ((<= altitude (clel-first b))
                         (tod-color-mix
                          (clel-second a)
                          (clel-second b)
                          (/ (- altitude (clel-first a))
                             (- (clel-first b) (clel-first a)))))
                        (t (recur (cdr frames)))))))
    (recur keyframes)))

(defun tod-gradient-low-sun (altitude)
  "Return how strongly the sun at ALTITUDE colours the light, in [0, 1].
It is 1 at the horizon and fades to 0 at 12 degrees either side."
  (max 0.0 (- 1.0 (/ (abs altitude) 12.0))))

(defvar tod-gradient-morning-light "#d6e4ff"
  "Colour the eastern sun mixes into daytime backgrounds.")

(defvar tod-gradient-afternoon-light "#ffdcb0"
  "Colour the western sun mixes into daytime backgrounds.")

(defvar tod-gradient-dusk-shade "#2b1d4f"
  "Colour mixed into the night while the sun is still in the west.")

(defvar tod-gradient-dawn-shade "#103449"
  "Colour mixed into the night once the sun has moved to the east.")

(defun tod-gradient-west-ness (azimuth)
  "Return how far west the sun's AZIMUTH points, from 0 east to 1 west.
AZIMUTH is a compass bearing in degrees; nil gives nil."
  (when azimuth (/ (- 1.0 (sin (degrees-to-radians azimuth))) 2.0)))

(defun tod-gradient-background (moment warmth)
  "Return the background for the sky described by MOMENT.
MOMENT needs :altitude and :rising, and may carry :azimuth,
:illumination, :moon-altitude and :element.  WARMTH scales the
golden-hour tint."
  (let* ((altitude (clel-get moment :altitude))
         (dark (< altitude 0.0))
         (base
          (if dark
              (tod-gradient-interpolate tod-gradient-dark-keyframes altitude)
            (tod-gradient-interpolate tod-gradient-light-keyframes altitude)))
         (twilight (if dark (* 0.35 (tod-gradient-low-sun altitude)) 0.0))
         (tinted
          (tod-color-mix base
                         (if (clel-get moment :rising)
                             tod-gradient-rising-tint
                           tod-gradient-setting-tint)
                         twilight))
         (moon-alt (or (clel-get moment :moon-altitude) -90.0))
         (moonlit
          (if (and dark (> moon-alt 0.0))
              (tod-color-mix
               tinted
               tod-gradient-moonlight
               (* 0.5
                  (or (clel-get moment :illumination) 0.0)
                  (sin (degrees-to-radians moon-alt))))
            tinted))
         (warm
          (if dark
              moonlit
            (tod-color-mix moonlit
                           tod-palette-warm-light
                           (* warmth (tod-gradient-low-sun altitude)))))
         (west (tod-gradient-west-ness (clel-get moment :azimuth)))
         (drifted
          (cond
           ((null west) warm)
           (dark
            (tod-color-mix
             (tod-color-mix warm tod-gradient-dawn-shade (* 0.12 (- 1.0 west)))
             tod-gradient-dusk-shade
             (* 0.12 west)))
           (t
            (tod-color-mix
             (tod-color-mix warm
                            tod-gradient-morning-light
                            (* 0.1 (- 1.0 west)))
             tod-gradient-afternoon-light
             (* 0.1 west)))))
         (elem
          (alist-get (clel-get moment :element) tod-gradient-element-colors)))
    (if elem (tod-color-mix drifted elem 0.03) drifted)))

(defun tod-gradient--accent (hue altitude dark warmth west)
  "Return the accent for HUE in degrees at ALTITUDE over a background.
DARK says whether the background is dark.  Saturation follows the sun
from muted at the nadir to vivid at the zenith, the hue leans by up to
6 degrees with WEST, how far west the sun stands, and accents warm
towards `tod-palette-warm-light' by WARMTH while the sun is low."
  (let* ((height (/ altitude 90.0))
         (saturation (+ 0.52 (* 0.18 height)))
         (lightness (if dark (- 0.66 (* 0.06 height)) (- 0.42 (* 0.08 height))))
         (lean (* 12.0 (- (or west 0.5) 0.5))))
    (tod-color-mix
     (tod-color-from-hsl (/ (mod (+ hue lean) 360.0) 360.0)
                         saturation
                         lightness)
     tod-palette-warm-light
     (* 2.0 warmth (tod-gradient-low-sun altitude)))))

(defun tod-gradient-wal (moment warmth)
  "Return a pywal-shaped palette for MOMENT, before contrast repair.
WARMTH scales how much low sunlight warms the colours."
  (let* ((bg (tod-gradient-background moment warmth))
         (dark (tod-color-dark-p bg))
         (altitude (clel-get moment :altitude))
         (west (tod-gradient-west-ness (clel-get moment :azimuth)))
         (fg (if dark "#dcdfe8" "#22242c"))
         (accents
          (mapcar
           (lambda (entry)
             (tod-gradient--accent (clel-second entry)
                                   altitude
                                   dark
                                   warmth
                                   west))
           tod-palette-semantic-hues)))
    (clel-array-map :background bg
                    :foreground fg
                    :cursor (or
                             (alist-get (clel-get moment :planet)
                                        tod-gradient-planet-colors)
                             fg)
                    :colors (append (list bg)
                                    (seq-take accents 6)
                                    (list fg (tod-color-mix fg bg 0.45))
                                    (seq-drop accents 6)
                                    (seq-take accents 5)
                                    (list fg)))))

(defun tod-gradient-generate (moment warmth ratio)
  "Return the semantic palette for MOMENT.
WARMTH scales the low-sun tint and RATIO is the contrast every accent
reaches, as in `tod-palette-semantic'."
  (tod-palette-semantic (tod-gradient-wal moment warmth) ratio))

(defcustom tod-sky-interval 300
  "Seconds between two repaints of a look whose :palette is sky.
The sky palette follows the sun's altitude continuously, so a shorter
interval means smoother change and more redraws."
  :type 'integer
  :group 'tod)

(defvar tod-gradient--painted nil
  "The sky palette last turned into a theme.")

(defun tod-gradient-paint (name moment warmth ratio)
  "Make the theme NAME follow the sky of MOMENT and return the palette.
WARMTH and RATIO are as for `tod-gradient-generate'.  The theme is only
redefined when the palette changed since the last call."
  (let* ((p (tod-gradient-generate moment warmth ratio)))
    (if (and (equal p tod-gradient--painted) (memq name custom-enabled-themes))
        nil
      (progn
        (tod-theme-define-palette-theme name p)
        (tod-theme-switch name)
        (setq tod-gradient--painted p)))
    p))

(defun tod-gradient-next-repaint (time)
  "Return when a sky palette should next be repainted after TIME."
  (time-add time tod-sky-interval))

(provide 'tod-gradient)
